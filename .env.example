# Public Supabase project URL and anon key (safe for client use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TMDB_API_KEY=your-tmdb-v3-api-key
# Enable live Vibe Check discovery only after confirming the applicable TMDB terms.
TMDB_NONCOMMERCIAL_USE_CONFIRMED=false
TMDB_COMMERCIAL_LICENSE_CONFIRMED=false
